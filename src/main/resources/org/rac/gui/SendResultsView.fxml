<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    RAC Operational App — SendResultsView (Redesigned)
    CSS: place rac-styles.css in the same resources folder as this FXML.
    Controller: org.rac.gui.SendResultsViewController  (unchanged)

    All fx:id values PRESERVED:
        filePathLabel, datePicker, classField, batchComboBox,
        customBatchLabel, customBatchField, topicField, headingField,
        totalMarksField, sendWhatsAppCheckbox, progressBar, progressLabel

    All onAction handlers PRESERVED:
        #handleChooseFile, #handleProceed, #handleAbort, #handleBackToHome
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.rac.gui.SendResultsViewController"
      stylesheets="@rac-styles.css"
      prefWidth="820"
      prefHeight="800">

    <!-- ══════════════════════════════════════════
         HEADER BAR  (gradient blue)
         ══════════════════════════════════════════ -->
    <HBox styleClass="send-header-bar"
          alignment="CENTER_LEFT"
          spacing="14">

        <!-- Icon pill -->
        <StackPane styleClass="send-header-icon-box">
            <Label text="↑"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </StackPane>

        <!-- Title + sub-title -->
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Send Results to Parents" styleClass="send-header-title"/>
            <Label text="Fill in the details below and click Proceed"
                   styleClass="send-header-subtitle"/>
        </VBox>

        <!-- Back button (right-aligned) -->
        <Button text="← Back to Home"
                styleClass="back-button"
                onAction="#handleBackToHome"/>
    </HBox>

    <!-- ══════════════════════════════════════════
         SCROLLABLE CONTENT
         ══════════════════════════════════════════ -->
    <ScrollPane styleClass="send-scroll-pane"
                fitToWidth="true"
                VBox.vgrow="ALWAYS">

        <VBox styleClass="send-content-vbox" spacing="14">

            <!-- ─────────────────────────────────────────
                 CARD 1 — Data Source
                 ───────────────────────────────────────── -->
            <VBox styleClass="form-card" spacing="11">

                <Label text="DATA SOURCE" styleClass="form-card-header"/>

                <!-- Excel file row -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Excel File:" styleClass="form-label"/>
                    <Button text="⊞ Choose File"
                            styleClass="file-choose-button"
                            onAction="#handleChooseFile"/>
                    <Label fx:id="filePathLabel"
                           text=""
                           styleClass="file-path-label"
                           wrapText="true"/>
                </HBox>

                <!-- HTML template (info only) -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="HTML Template:" styleClass="form-label"/>
                    <Label text="✓  result_template.html  (from resources)"
                           styleClass="template-info-label"/>
                </HBox>

            </VBox>

            <!-- ─────────────────────────────────────────
                 CARD 2 — Test Details
                 ───────────────────────────────────────── -->
            <VBox styleClass="form-card" spacing="11">

                <Label text="TEST DETAILS" styleClass="form-card-header"/>

                <!-- Date -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Test Conducted Date:" styleClass="form-label"/>
                    <DatePicker fx:id="datePicker"
                                styleClass="form-date-picker"
                                prefWidth="200"/>
                </HBox>

                <!-- Class -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Class:" styleClass="form-label"/>
                    <TextField fx:id="classField"
                               styleClass="form-text-field"
                               promptText="e.g. Class X"
                               prefWidth="260"/>
                </HBox>

                <!-- Batch -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Batch:" styleClass="form-label"/>
                    <ComboBox fx:id="batchComboBox"
                              styleClass="form-combo-box"
                              prefWidth="260"/>
                </HBox>

                <!-- Custom Batch (shown dynamically by controller) -->
                <HBox fx:id="customBatchRow" spacing="12" alignment="CENTER_LEFT"
                      visible="false" managed="false">
                    <Label fx:id="customBatchLabel"
                           text="Custom Batch:"
                           styleClass="form-label"
                           visible="false" managed="false"/>
                    <TextField fx:id="customBatchField"
                               styleClass="form-text-field"
                               promptText="Enter batch name"
                               prefWidth="260"
                               visible="false" managed="false"/>
                </HBox>

                <!-- Topic -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Topic:" styleClass="form-label"/>
                    <TextField fx:id="topicField"
                               styleClass="form-text-field"
                               promptText="e.g. Kinematics"
                               prefWidth="260"/>
                </HBox>

                <!-- Result Heading -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Result Heading:" styleClass="form-label"/>
                    <TextField fx:id="headingField"
                               styleClass="form-text-field"
                               promptText="e.g. Unit Test 1 Results"
                               prefWidth="360"/>
                </HBox>

                <!-- Total Marks -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Total Marks:" styleClass="form-label"/>
                    <TextField fx:id="totalMarksField"
                               styleClass="form-text-field"
                               promptText="e.g. 40"
                               prefWidth="120"/>
                </HBox>

            </VBox>

            <!-- ─────────────────────────────────────────
                 WHATSAPP SEND ROW
                 ───────────────────────────────────────── -->
            <HBox styleClass="wa-card" spacing="10" alignment="CENTER_LEFT">
                <CheckBox fx:id="sendWhatsAppCheckbox"
                          text="Send results on WhatsApp"
                          styleClass="wa-checkbox"
                          selected="true"/>
                <Label text="Messages will be delivered to parent contacts via WhatsApp."
                       style="-fx-text-fill: #4ade80; -fx-font-size: 11px;"/>
            </HBox>

            <!-- ─────────────────────────────────────────
                 ACTION BUTTONS
                 ───────────────────────────────────────── -->
            <HBox styleClass="action-row" spacing="10" alignment="CENTER_LEFT">
                <Button text="▶  Proceed"
                        styleClass="proceed-button"
                        onAction="#handleProceed"/>
                <Button text="✕  Abort"
                        styleClass="abort-button"
                        onAction="#handleAbort"/>
            </HBox>

            <!-- ─────────────────────────────────────────
                 PROGRESS SECTION
                 ───────────────────────────────────────── -->
            <VBox styleClass="progress-section" spacing="5">
                <ProgressBar fx:id="progressBar"
                             progress="0.0"
                             styleClass="progress-bar"
                             maxWidth="Infinity"
                             VBox.vgrow="NEVER"/>
                <Label fx:id="progressLabel"
                       text=""
                       styleClass="progress-status-label"/>
            </VBox>

        </VBox>
    </ScrollPane>

</VBox>
