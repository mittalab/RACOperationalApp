<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.rac.gui.SendResultsViewController"
      alignment="CENTER" spacing="15">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Send Results to Parents" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">

        <!-- Row 0: Excel File (first) -->
        <Label text="Excel File:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Button text="Choose File" onAction="#handleChooseFile" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label fx:id="filePathLabel" text="" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

        <!-- Row 1: Date -->
        <Label text="Test Conducted Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="datePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Row 2: Class -->
        <Label text="Class:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="classField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Row 3: Batch dropdown -->
        <Label text="Batch:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="batchComboBox" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <!-- Row 4: Custom batch (shown only when "Other" is selected) -->
        <Label fx:id="customBatchLabel" text="Custom Batch:" GridPane.rowIndex="4" GridPane.columnIndex="0"
               visible="false" managed="false"/>
        <TextField fx:id="customBatchField" promptText="Enter batch name" GridPane.rowIndex="4" GridPane.columnIndex="1"
                   visible="false" managed="false"/>

        <!-- Row 5: Topic -->
        <Label text="Topic:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="topicField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <!-- Row 6: Result Heading -->
        <Label text="Result Heading:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="headingField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <!-- Row 7: Total Marks -->
        <Label text="Total Marks:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="totalMarksField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <!-- Row 8: HTML Template (info only) -->
        <Label text="HTML Template:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <Label text="result_template.html (from resources)" GridPane.rowIndex="8" GridPane.columnIndex="1"
               GridPane.columnSpan="2"/>

        <!-- Row 9: WhatsApp send checkbox -->
        <CheckBox fx:id="sendWhatsAppCheckbox" text="Send results on WhatsApp"
                  selected="true"
                  GridPane.rowIndex="9" GridPane.columnIndex="0" GridPane.columnSpan="3"/>

    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Proceed" onAction="#handleProceed"/>
        <Button text="Abort" onAction="#handleAbort"/>
        <Button text="Back to Home" onAction="#handleBackToHome"/>
    </HBox>

    <ProgressBar fx:id="progressBar" progress="0.0" VBox.vgrow="NEVER"/>
    <Label fx:id="progressLabel" text=""/>

</VBox>
